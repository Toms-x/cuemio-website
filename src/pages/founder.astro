---
// src/pages/founder.astro
import Layout from '../layouts/Layout.astro';

const skills = [
  'SEO & Content Ops',
  'Automation (Python, GCP, n8n)',
  'Analytics & Data',
  'Research & Evaluation Design',
  'GTM Engineering Strategy',
  'Decentralized Finance',
];
---
<Layout
  title="Ayotomiwa Oladotun, Founder of Cuemio"
  description="A research-driven growth strategist who investigates AI systems, designs evaluations, and translates technical findings into actionable market insights."
  theme="light"
>
  <div class="max-w-2xl mx-auto px-6 py-20 md:py-28 font-body">

    <div class="flex items-center gap-5 mb-8">
      <img src="/images/my pro picture.png" alt="Ayotomiwa Oladotun" class="w-16 h-16 rounded-full border border-[#DEE2DC] object-cover" />
      <h1 class="font-display text-2xl font-semibold text-[#12151A]">Ayotomiwa Oladotun</h1>
    </div>

    <p class="text-lg text-[#12151A] leading-relaxed mb-6">
      A research-driven growth strategist who investigates AI systems, designs evaluations, and translates technical findings into actionable market insights.
    </p>

    <div class="space-y-4 text-[#565C63] leading-relaxed mb-10">
      <p>
        I'm an engineer by training who moved into growth. Over seven years I've worked on search, content and community for financial platforms, including decentralized finance products.
      </p>
      <p>
        I'm building Cuemio, a growth engineering startup that turns scattered market signals into decisions a team can act on.
      </p>
      <p>
        I also research how AI answer engines use the web. My published paper,
        <a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7468658" target="_blank" rel="noopener noreferrer" class="text-[#3A36E0] hover:underline">Cited but Not Clicked</a>,
        measures what Google AI Overviews did to click-through on a financial platform's pages. I'm now running a benchmark of which sources these engines retrieve versus which they cite, with hypotheses committed before each run.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {skills.map((s) => (
        <span class="text-xs px-3 py-1.5 bg-white text-[#565C63] rounded-full border border-[#DEE2DC]">
          {s}
        </span>
      ))}
    </div>

  </div>
</Layout>