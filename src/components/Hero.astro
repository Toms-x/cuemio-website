---
// src/components/Hero.astro
---
<section class="relative overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img 
            src="/images/hero-visualizer.png" 
            alt="Abstract data visualization background" 
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 py-32 md:py-40">
        <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-widest text-blue-400 mb-5">
                Growth Strategy · SEO · Data Systems
            </p>
            <h1 class="text-5xl md:text-7xl font-bold text-slate-100 leading-tight">
                Engineer-turned-growth strategist.
            </h1>
            <p class="mt-6 text-lg text-slate-200 max-w-2xl">
                I build the data systems behind the marketing. Seven years turning research, automation, and analytics into organic growth for crypto and fintech platforms &mdash; currently SEO Manager at YEX Exchange.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row gap-4">
                <a href="#projects" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors">
                    Explore the Work
                </a>
                <a href="https://www.linkedin.com/in/ayotomiwa-oladotun-84b278132" target="_blank" class="border border-slate-600 hover:bg-slate-800 text-slate-200 font-semibold px-8 py-3 rounded-lg transition-colors">
                    Connect on LinkedIn
                </a>
            </div>

            <div class="mt-8 flex items-center gap-2 text-sm text-slate-400">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                </span>
                Now: leading global organic growth at YEX Exchange.
            </div>
        </div>
    </div>
</section>