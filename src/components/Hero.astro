---
// src/components/Hero.astro
const signals = [
  'RSS', 'REDDIT', 'GOOGLE TRENDS', 'SEARCH CONSOLE',
  'COMPETITOR GAPS', 'MARKET ANOMALIES', 'TOKEN UNLOCKS'
];
---
<section class="relative overflow-hidden font-body">
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 pt-28 pb-20 md:pt-36 md:pb-28">
        <div class="max-w-3xl">
            <span class="cue-light is-standby font-plex-mono text-xs uppercase tracking-widest text-[#565C63] border border-[#DEE2DC] rounded-full pl-2.5 pr-3 py-1.5 mb-7">
                <span class="dot"></span>
                Early access
            </span>

            <h1 class="font-display text-[2.75rem] leading-[1.1] md:text-6xl md:leading-[1.08] font-semibold text-[#12151A] tracking-tight">
                Growth, engineered.
            </h1>
            <p class="mt-6 text-lg text-[#565C63] max-w-2xl leading-relaxed">
                Cuemio brings GTM engineering to high-growth startups. We deploy technical SEO, automated content frameworks, and data systems that tell you exactly what to build, where to spend, and how to scale your pipeline.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row gap-3">
                <a href="#cta" class="bg-[#12151A] hover:bg-[#3A36E0] text-white font-medium px-7 py-3 rounded-full transition-colors text-center">
                    Join the waitlist
                </a>
                <a href="#projects" class="border border-[#DEE2DC] hover:border-[#12151A] text-[#12151A] font-medium px-7 py-3 rounded-full transition-colors text-center">
                    See the modules
                </a>
            </div>

            <div class="mt-8 cue-light is-go font-plex-mono text-xs text-[#565C63]">
                <span class="dot"></span>
                Now: the SEO intelligence bot is live, running organic growth at YEX Exchange.
            </div>
        </div>
    </div>

    <!-- Signal ticker: the seven sources feeding the engine, in motion -->
    <div class="relative border-y border-[#DEE2DC] bg-white/60 py-4 overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_96px,_black_calc(100%-96px),transparent_100%)]">
        <div class="flex w-max animate-ticker">
            {[...signals, ...signals].map((s) => (
                <span class="font-plex-mono text-xs tracking-widest text-[#565C63] mx-6 whitespace-nowrap flex items-center gap-2">
                    <span class="w-1 h-1 rounded-full bg-[#565C63]/50"></span>
                    {s}
                </span>
            ))}
        </div>
    </div>
</section>