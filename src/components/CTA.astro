---
// src/components/CTA.astro
---
<section id="cta" class="py-20 md:py-24 font-body">
    <div class="max-w-3xl mx-auto px-6 md:px-10">
        <div class="rounded-3xl bg-[#12151A] text-white p-10 md:p-14 text-center">
            <span class="cue-light is-go font-plex-mono text-xs uppercase tracking-widest text-white/60 border border-white/15 rounded-full pl-2.5 pr-3 py-1.5 mb-6">
                <span class="dot"></span>
                Accepting early access
            </span>
            <h2 class="font-display text-3xl md:text-4xl font-semibold">Get early access to Cuemio.</h2>
            <p class="mt-4 text-lg text-white/60 max-w-xl mx-auto leading-relaxed">
                The SEO intelligence bot is live today. Join the waitlist to be first in line as the rest of the modules ship &mdash; or reach out directly if you want to talk shop.
            </p>

            <form id="waitlist-form" class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
                <label for="waitlist-email" class="sr-only">Email address</label>
                <input
                    id="waitlist-email"
                    type="email"
                    required
                    placeholder="name@company.com"
                    class="flex-1 bg-white/5 border border-white/15 text-white placeholder:text-white/35 rounded-full px-5 py-3 font-plex-mono text-sm focus:outline-none focus:ring-2 focus:ring-[#3A36E0] focus:border-transparent"
                />
                <button id="waitlist-submit" type="submit" class="bg-white text-[#12151A] font-medium px-6 py-3 rounded-full transition-colors hover:bg-[#3A36E0] hover:text-white whitespace-nowrap">
                    Get early access
                </button>
            </form>
            <p id="waitlist-status" class="mt-4 text-sm text-white/60 hidden"></p>

            <p class="mt-6 text-sm text-white/40">
                Prefer email? <a href="mailto:oladotuntomiwa@gmail.com" class="text-white/70 hover:text-white transition-colors underline underline-offset-4">Reach out directly</a>.
            </p>
        </div>
    </div>
</section>

<script>
  // Web app URL from Apps Script deployment.
  const WAITLIST_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbz3OouwYzuHA39ST3LbGQdfSyC4KQRquUmFOA5iSx3a9_cY9VJFRiq8VbTHzhY7CUss/exec';

  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('waitlist-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !submitBtn || !statusEl) return;

    const email = emailInput.value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Joining...';

    try {
      await fetch(WAITLIST_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ email }),
      });

      statusEl.textContent = "You're on the list. We'll be in touch.";
      statusEl.classList.remove('hidden');
      form.reset();
      submitBtn.textContent = 'Get early access';
    } catch (err) {
      statusEl.textContent = 'Something went wrong — try the email link below instead.';
      statusEl.classList.remove('hidden');
      submitBtn.textContent = 'Get early access';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>