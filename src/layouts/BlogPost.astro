---
// src/layouts/BlogPost.astro

const { frontmatter } = Astro.props;
---
<article class="max-w-3xl mx-auto px-6 py-12 md:py-20 font-body">
  <header class="mb-10 text-center">
    <p class="font-plex-mono text-xs text-[#8A9088] mb-3">
      Published on: {(new Date(frontmatter.pubDate)).toLocaleDateString('en-us', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      })}
    </p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold text-[#12151A] leading-tight">
      {frontmatter.title}
    </h1>
  </header>

  {frontmatter.heroImage && (
    <img
      src={frontmatter.heroImage}
      alt={`Cover image for ${frontmatter.title}`}
      class="w-full rounded-2xl mb-10 aspect-[21/9] object-cover border border-[#DEE2DC]"
    />
  )}

  <div class="prose prose-lg max-w-none text-justify
      prose-headings:font-display prose-headings:font-semibold prose-headings:text-[#12151A]
      prose-p:text-[#565C63] prose-p:leading-relaxed
      prose-strong:text-[#12151A]
      prose-a:text-[#3A36E0]">
    <slot />
  </div>
</article>
