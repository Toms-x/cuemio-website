---
// src/layouts/Layout.astro

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  theme?: 'dark' | 'light';
}

const {
  title,
  description = "Cuemio pulls signal from seven sources, ranks the decision, and ships it to your team automatically.",
  image,
  theme = 'dark',
} = Astro.props;

const isLight = theme === 'light';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="icon" type="image/svg+xml" href="/favicon-cuemio.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Space+Grotesk:wght@700&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    {/* Google Analytics (GA4) Script */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-401E0S6TYS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-401E0S6TYS');
    </script>
  </head>
  <body class:list={[
    "antialiased",
    isLight
      ? "bg-[#F5F6F2] text-[#12151A] selection:bg-[#3A36E0] selection:text-white"
      : "bg-slate-900 text-slate-200 selection:bg-blue-600 selection:text-white"
  ]}>
    <Header theme={theme} />
    <main>
      <slot />
    </main>
    <Footer theme={theme} />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  :root {
    --font-sans: 'Inter', sans-serif;
    --font-heading: 'Space Grotesk', sans-serif;
  }
  /* Basic prose styles for content, if not using @tailwindcss/typography everywhere */
  main :where(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-heading);
    color: white;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    line-height: 1.2;
  }
  main :where(p, ul, ol, li) {
    font-family: var(--font-sans);
    line-height: 1.7;
    margin-bottom: 1em;
  }
</style>
