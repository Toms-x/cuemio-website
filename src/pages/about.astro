---
import Layout from '../layouts/Layout.astro';

const skills = [
  'SEO & Content Ops', 'Automation (Python, GCP, n8n)', 'Analytics & Data',
  'GTM Engineering Strategy', 'Web3 / DeFi',
];
---
<Layout
    title="About — Ayotomiwa Oladotun"
    description="Engineer-turned-growth strategist building Cuemio, the data systems behind the marketing."
    theme="light"
>
    <main class="max-w-2xl mx-auto px-6 py-20 md:py-28 font-body">

        <p class="font-plex-mono text-xs uppercase tracking-widest text-[#565C63] mb-6">About</p>

        <div class="flex items-center gap-5 mb-8">
            <img src="/images/my pro picture.png" alt="Ayotomiwa Oladotun" class="w-16 h-16 rounded-full border border-[#DEE2DC] object-cover" />
            <div>
                <h1 class="font-display text-2xl font-semibold text-[#12151A]">Ayotomiwa Oladotun</h1>
                <p class="text-[#3A36E0] font-medium">Building Cuemio</p>
            </div>
        </div>

        <p class="text-lg text-[#565C63] leading-relaxed mb-10">
            Trained as an engineer, spent seven years turning that into organic growth and lead generation for crypto and fintech platforms. Currently SEO Manager at YEX Exchange. Cuemio is the GTM system I built for the questions instinct can't answer: what to build, where to spend, and whether it worked.
        </p>

        <div class="flex flex-wrap gap-2 mb-10">
            {skills.map((s) => (
                <span class="text-xs px-3 py-1.5 bg-white text-[#565C63] rounded-full border border-[#DEE2DC]">
                    {s}
                </span>
            ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://calendly.com/ayotomiwa_/30min" target="_blank" rel="noopener noreferrer" class="bg-[#12151A] hover:bg-[#3A36E0] text-white font-medium px-7 py-3 rounded-full transition-colors text-center">
                Book a chat
            </a>
            <a href="/#projects" class="border border-[#DEE2DC] hover:border-[#12151A] text-[#12151A] font-medium px-7 py-3 rounded-full transition-colors text-center">
                See the modules
            </a>
        </div>

    </main>
</Layout>