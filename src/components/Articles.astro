---
// src/components/Articles.astro
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---
<section id="articles" class="py-20 md:py-24 font-body border-t border-[#DEE2DC]">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="font-plex-mono text-xs uppercase tracking-widest text-[#565C63] mb-3">Writing</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold text-[#12151A]">Latest teardowns</h2>
      </div>
      <a href="/blog" class="text-sm text-[#565C63] hover:text-[#3A36E0] transition-colors">All posts &rarr;</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="block bg-white rounded-2xl border border-[#DEE2DC] hover:border-[#12151A]/30 hover:shadow-lg hover:shadow-black/5 transition-all group overflow-hidden"
        >
          <img src={post.data.heroImage} alt="" class="aspect-video object-cover w-full" />
          <div class="p-6">
            <h3 class="font-display text-lg font-semibold text-[#12151A] group-hover:text-[#3A36E0] transition-colors">
              {post.data.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>